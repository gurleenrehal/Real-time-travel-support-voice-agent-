# Copy to .env and fill in only what you have. Every value below is
# OPTIONAL -- the app runs fully in mock mode with none of them set.

# Enables real LLM responses (function-calling) instead of the offline
# extractive mock responder.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Enables real ElevenLabs speech synthesis instead of the offline
# silent-WAV mock.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Used only if faster-whisper is installed and its model weights are
# reachable; otherwise STT falls back to the offline mock.
WHISPER_MODEL_SIZE=base

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
